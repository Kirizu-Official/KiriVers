# 只改这一份文件。docker compose 会把同一组值同时交给：
#   PostgreSQL 容器、Redis requirepass、KiriVers（DSN / Redis / 签名密钥）。
# 用法：cp .env.example .env && docker compose up -d
# 生产环境必须改掉所有 CHANGE_ME。

# 数据库名
POSTGRES_DB=kirivers
# 数据库用户名
POSTGRES_USER=kirivers
# 数据库密码
POSTGRES_PASSWORD=CHANGE_ME
# 数据库时区
POSTGRES_TZ='Asia/Shanghai'

# Redis 密码
REDIS_PASSWORD=CHANGE_ME_REDIS

# 下载签名密钥，建议不低于32位大写、小写、数字的随机字符串
URL_SIGNING_SECRET=CHANGE_ME_SIGNING
