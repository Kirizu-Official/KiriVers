{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "hosted",
      "displayName": "Hosted (libcurl, OpenSSL, libzip, utf8proc)",
      "binaryDir": "${sourceDir}/build/hosted",
      "cacheVariables": {
        "KIRIVERS_EMBEDDED": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "embedded",
      "displayName": "Embedded (cJSON + function pointers)",
      "binaryDir": "${sourceDir}/build/embedded",
      "cacheVariables": {
        "KIRIVERS_EMBEDDED": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "hosted",
      "configurePreset": "hosted"
    },
    {
      "name": "embedded",
      "configurePreset": "embedded"
    }
  ],
  "testPresets": [
    {
      "name": "hosted",
      "configurePreset": "hosted"
    },
    {
      "name": "embedded",
      "configurePreset": "embedded"
    }
  ]
}
